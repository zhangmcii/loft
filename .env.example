# =============================================================================
# 🚀 Loft社交项目 - 环境变量配置模板
# =============================================================================
# 使用前请将本文件复制为 .env 并填写所有必需参数
# 每个配置项都有详细说明，请仔细阅读后填写
# =============================================================================


# =============================================================================
# 🔧 Flask 应用核心配置
# =============================================================================

# Flask 应用入口文件
FLASK_APP=flasky.py

# 运行环境: development(开发)/testing(测试)/production(生产)/docker(Docker部署)
FLASK_CONFIG=docker

# Flask 服务监听端口（容器内）
FLASK_RUN_PORT=5000

# Flask 服务监听地址（容器内使用 0.0.0.0）
FLASK_RUN_HOST=0.0.0.0

# Flask 应用的密钥，用于会话加密等（务必修改！生成命令: openssl rand -hex 32）
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 密钥，用于生成用户令牌（务必修改！建议生成32位随机字符串）
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# 管理员邮箱 - 使用该邮箱注册的用户将自动获得管理员权限
FLASKY_ADMIN_MAIL=your-admin-email@example.com

# Redis 主机地址（Docker部署时使用容器名，本地开发使用 localhost）
REDIS_HOST=redis


# =============================================================================
# 🗄️ MySQL 数据库配置
# =============================================================================
# 本地开发：mysql+pymysql://root:password@localhost:3306/dbname?charset=utf8mb4
# Docker部署：mysql+pymysql://root:password@mysql:3306/dbname?charset=utf8mb4

# 开发环境数据库URL
DEV_DATABASE_URL=mysql+pymysql://root:your-mysql-password@mysql:3306/loft_dev?charset=utf8mb4

# 测试环境数据库URL
TEST_DATABASE_URL=mysql+pymysql://root:your-mysql-password@mysql:3306/loft_test?charset=utf8mb4

# 生产环境数据库URL
DATABASE_URL=mysql+pymysql://root:your-mysql-password@mysql:3307/loft_prod?charset=utf8mb4


# =============================================================================
# # Redis 缓存配置
# =============================================================================
# Docker部署格式: redis://:密码@redis:6379/数据库编号
# 本地开发格式: redis://:密码@localhost:6379/数据库编号

# 开发环境Redis URL
DEV_REDIS_URL=redis://:1234@redis:6379/0

# 测试环境Redis URL
TEST_REDIS_URL=redis://:1234@redis:6379/0

# 生产环境Redis URL
REDIS_URL=redis://:1234@redis:6380/0


# =============================================================================
# 📧 QQ 邮箱服务配置（用于发送验证码）
# =============================================================================
# 📌 申请指引：登录QQ邮箱 → 设置 → 账户 → 开启SMTP服务 → 生成授权码

# SMTP服务器地址（QQ邮箱使用: smtp.qq.com）
MAIL_SERVER=smtp.qq.com

# SMTP服务器端口（QQ邮箱使用: 587 或 465）
MAIL_PORT=587

# 是否使用TLS加密（QQ邮箱使用: true）
MAIL_USE_TLS=true

# 邮箱账号（你的QQ邮箱地址，如: 123456@qq.com）
MAIL_USERNAME=your-qq-email@qq.com

# 邮箱授权码（不是QQ密码！在QQ邮箱设置中生成的16位授权码）
MAIL_PASSWORD=your-16-qq-email-authorization-code

# 默认发件人邮箱（通常与MAIL_USERNAME相同）
MAIL_DEFAULT_SENDER=your-qq-email@qq.com


# =============================================================================
# ☁️ 七牛云存储配置（用于图片上传）
# =============================================================================
# 📌 申请指引：
# 1. 注册七牛云账号：https://www.qiniu.com/
# 2. 创建存储空间（Bucket）
# 3. 获取 AccessKey 和 SecretKey（个人中心 → 密钥管理）
# 4. 配置自定义域名或测试域名

# 七牛云 AccessKey（从七牛云控制台获取）
QINIU_ACCESS_KEY=your-qiniu-access-key

# 七牛云 SecretKey（从七牛云控制台获取）
QINIU_SECRET_KEY=your-qiniu-secret-key

# 七牛云存储空间名称（你创建的Bucket名称）
QINIU_BUCKET_NAME=your-bucket-name

# 七牛云域名（必须以 http:// 或 https:// 开头，结尾不加 /）
# 示例：http://your-domain.com 或 http://xxx.cdn.com
QINIU_DOMAIN=http://your-qiniu-domain.com


# =============================================================================
# 🔐 第三方 OAuth 登录配置（可选）
# =============================================================================
# 📌 各平台申请指引：

# -----------------------------------
# GitHub OAuth 配置
# 📌 申请地址：https://github.com/settings/developers
# 1. 点击 "New OAuth App"
# 2. Homepage URL: https://your-domain.com
# 3. Authorization callback URL: https://your-domain.com/api/auth/oauth/callback/github
# -----------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# -----------------------------------
# Google OAuth 配置
# 📌 申请地址：https://console.cloud.google.com/apis/credentials
# 1. 创建 OAuth 2.0 客户端 ID
# 2. 已获授权的重定向 URI: https://your-domain.com/api/auth/oauth/callback/google
# 3. 需要配置 OAuth 同意屏幕
# -----------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------
# QQ OAuth 配置
# 📌 申请地址：https://connect.qq.com/
# 1. 创建网站应用
# 2. 网站回调域: your-domain.com
# -----------------------------------
QQ_CLIENT_ID=your-qq-client-id
QQ_CLIENT_SECRET=your-qq-client-secret

# -----------------------------------
# 微博 OAuth 配置
# 📌 申请地址：https://open.weibo.com/
# 1. 创建网站应用
# 2. 授权回调页: https://your-domain.com/api/auth/oauth/callback/weibo
# -----------------------------------
WEIBO_CLIENT_ID=your-weibo-client-id
WEIBO_CLIENT_SECRET=your-weibo-client-secret


# =============================================================================
# 🐳 Docker 部署专用配置
# =============================================================================

# 标记应用运行在Docker环境（不要修改）
RUN_APP=True

# 前端OAuth回调地址（Docker部署时使用域名）
# 格式: https://your-domain.com/oauth/callback
FRONTEND_OAUTH_REDIRECT=https://your-domain.com/oauth/callback


# =============================================================================
# 🌐 前端配置（Vite 构建时注入）
# =============================================================================

# 前端开发服务器端口
VITE_PORT=5172

# 前端路由基础路径（根目录使用 /）
VITE_BASE=/

# 后端API代理路径
VITE_APP_BASE_API=/api

# ICP备案号（如果网站需要备案）
VITE_ICP=your-icp-number

# 七牛云域名（与后端QINIU_DOMAIN保持一致，用于前端显示图片）
VITE_QINIU_DOMAIN=your-qiniu-domain.com

# 七牛云存储空间名称（与后端QINIU_BUCKET_NAME保持一致）
VITE_QINIU_BUCKET=your-bucket-name


# =============================================================================
# 📊 性能与分页配置
# =============================================================================

# 每页显示帖子数量
FLASKY_POSTS_PER_PAGE=10

# 每页显示关注者数量
FLASKY_FOLLOWERS_PER_PAGE=15

# 每页显示评论数量
FLASKY_COMMENTS_PER_PAGE=10

# 评论回复每页数量
FLASKY_COMMENTS_REPLY_PER_PAGE=5

# 操作日志每页数量
FLASKY_LOG_PER_PAGE=15

# 聊天记录每页数量
FLASKY_CHAT_PER_PAGE=15

# 慢查询阈值（秒）
FLASKY_SLOW_DB_QUERY_TIME=0.5


# =============================================================================
# ⚠️ 配置检查清单（部署前请逐一核对）
# =============================================================================
# ☐ SECRET_KEY 和 JWT_SECRET_KEY 已修改为随机字符串
# ☐ MySQL 密码已修改（替换所有 your-mysql-password）
# ☐ QQ邮箱授权码已获取并填写
# ☐ 七牛云 AccessKey/SecretKey/Bucket/Domain 已配置
# ☐ 至少配置了一个第三方 OAuth 登录（建议 GitHub）
# ☐ 管理员邮箱已设置为你的邮箱
# ☐ 域名已替换为实际域名（用于OAuth回调）
# ☐ Redis 和 MySQL 的密码保持一致
# ☐ ICP备案号已填写（如需要）
